# ── BANKAI Frontend — Environment Variables ──
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Docker/EC2 deployment, pass these as environment variables:
#   docker run -e REACT_APP_BACKEND_URL=http://<EC2_BACKEND_IP>:8081 bankai-frontend
#

# Backend API base URL (include protocol and port, no trailing slash)
# Examples:
#   http://localhost:8081           — local development
#   http://3.110.45.123:8081       — EC2 instance private/public IP
#   https://api.yourdomain.com     — production with domain
REACT_APP_BACKEND_URL=http://localhost:8081
